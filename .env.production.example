# Inify - Production environment TEMPLATE (fake values only)
# Real values must be set in the hosting provider's secret manager (e.g. Render > Environment).
# Never commit a file with real values. `.env.*` is git-ignored except *.example files.

# Django
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=inify.ai,www.inify.ai
CSRF_TRUSTED_ORIGINS=https://inify.ai,https://www.inify.ai
CORS_ALLOWED_ORIGINS=https://inify.ai,https://www.inify.ai
SITE_URL=https://inify.ai
LOG_LEVEL=INFO

# Admin panel
ADMIN_SECRET_KEY=change-me
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Field encryption (Fernet). To rotate: "new_key,old_key", re-encrypt, then drop old_key.
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# Database (Render sets DATABASE_URL automatically)
DATABASE_URL=
USE_POSTGRES=True
DB_NAME=inify_production
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Cache / Channels
REDIS_URL=

# AI
OPENAI_API_KEY=change-me
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FROM_EMAIL=Inify <noreply@inify.ai>
REPLY_TO_EMAIL=info@inify.ai
RESEND_API_KEY=change-me

# Google OAuth
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=change-me
RECAPTCHA_SECRET_KEY=change-me
RECAPTCHA_DISABLED=False

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=inify

# StreamPay
STREAMPAY_API_KEY=change-me
STREAMPAY_API_SECRET=change-me
STREAMPAY_WEBHOOK_SECRET=change-me
STREAMPAY_PRODUCT_MONTHLY_ID=
STREAMPAY_PRODUCT_QUARTERLY_ID=
STREAMPAY_PRODUCT_SEMI_ID=
STREAMPAY_PRODUCT_ANNUAL_ID=
