# Newra Estate AI - Environment Variables
# Copy this file to .env and fill in your values

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin Panel Security
ADMIN_SECRET_KEY=your-admin-secret-key-change-this
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-secure-admin-password

# Field Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=your-encryption-key-here

# Database (PostgreSQL / Supabase)
DB_NAME=newra_estate
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key

# Gemini API (for RAG)
GEMINI_API_KEY=your-gemini-api-key

# AI Model Settings
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Supabase (for Vector Store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# n8n Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/newra
N8N_WEBHOOK_SECRET=your-webhook-secret

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@newra.estate

# Resend Email Service (Recommended for production)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=Inify <noreply@inify.ai>
SITE_URL=https://inify.ai

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
